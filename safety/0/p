FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    FrontAndBack
    {
        type            empty;
    }
    Aerofoil
    {
        type            zeroGradient;
    }
    Inlet
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        supersonic      false;
        value           uniform 0;
    }
    Outlet
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        supersonic      false;
        value           uniform 0;
    }
    Top1
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        supersonic      false;
        value           uniform 0;
    }
    Bottom1
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        supersonic      false;
        value           uniform 0;
    }
    Top2
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        supersonic      false;
        value           uniform 0;
    }
    Bottom2
    {
        type            freestreamPressure;
        freestreamValue uniform 0;
        supersonic      false;
        value           uniform 0;
    }
}


